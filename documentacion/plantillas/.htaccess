# .htaccess para servir el SPA Angular (Vocare UBB) en un hosting Apache/cPanel
# (V2Networks Plan Emprendedor u otro equivalente).
#
# Angular vive en el navegador: para el servidor, TODAS las rutas de la app
# (/portal/lavoz, /administracion/usuario, /portalmedico/perfil, etc.) no
# existen como archivos reales. Sin esta reescritura, recargar la página en
# cualquier ruta que no sea la raíz devuelve un 404 del propio Apache en vez
# de dejar que Angular Router la resuelva del lado del cliente.
#
# PLANTILLA — todavía no activada. Para usarla, copia este archivo a
# public/.htaccess en la raíz del proyecto:
#
#   cp documentacion/plantillas/.htaccess public/.htaccess
#
# Recién ahí `ng build` lo copiará automáticamente a
# dist/FrontendVocareUBB/browser/ (ver "assets" en angular.json).
# Ver documentacion/DEPLOY_V2NETWORKS.md para el resto del proceso.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Si ya despliegas bajo una subcarpeta (ej. /vocare-ubb/), descomenta y ajusta:
  # RewriteBase /vocare-ubb/

  # No reescribir peticiones a archivos o carpetas que sí existen
  # (index.html, main-*.js, styles-*.css, favicon.ico, assets/, etc.)
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d

  # Todo lo demás cae en index.html; Angular Router toma el control desde ahí
  RewriteRule ^ index.html [L]
</IfModule>

# Fuerza HTTPS (el Plan Emprendedor incluye SSL gratis vía AutoSSL).
# Actívalo una vez que el certificado esté emitido para el dominio.
<IfModule mod_rewrite.c>
  RewriteCond %{HTTPS} off
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]
</IfModule>

# Compresión de texto (JS/CSS/HTML/SVG) para acelerar la carga inicial
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript
  AddOutputFilterByType DEFLATE application/javascript application/json application/xml
  AddOutputFilterByType DEFLATE image/svg+xml
</IfModule>

# Cache agresivo para assets con hash en el nombre (outputHashing: "all" en
# angular.json ya garantiza que cambian de nombre en cada build), y cache
# corto para index.html para que los usuarios reciban rápido cada release.
<IfModule mod_expires.c>
  ExpiresActive On

  ExpiresByType text/html "access plus 0 seconds"

  ExpiresByType application/javascript "access plus 1 year"
  ExpiresByType text/css "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"
  ExpiresByType font/woff2 "access plus 1 year"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "index\.html$">
    Header set Cache-Control "no-cache, no-store, must-revalidate"
  </FilesMatch>
</IfModule>
